# OS / editor cruft
Thumbs.db
Desktop.ini
.DS_Store
*.swp
.vscode/

# Local exports / backups (your health data — keep it off git)
operation-health-*.json

# The live-data folder holds real logged health data — keep ALL of it off git,
# whatever the files are named. Only the explanatory README is tracked.
/live-data/*
!/live-data/README.md

# The ideas folder is the private brainstorm inbox — notes here are expected to
# carry personal health/macro detail, so keep ALL of it off git. Only the
# explanatory README (which holds no personal data) is tracked.
/docs/ideas/*
!/docs/ideas/README.md
